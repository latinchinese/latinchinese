<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>物流费用对比 · 透明化物流平台</title>
    <link rel="stylesheet" href="c_operativo.css">
</head>
<body>
    <div class="topbar">
        <div class="logo" onclick="window.location.href='../index.html'">
            <span class="logo-mini">🌐</span>
            <span class="logo-cn">透明化物流平台</span>
            <span class="logo-es">Comparador de Costos</span>
        </div>
        <div class="lang-toggle" onclick="toggleLang()">
            <div class="lang-opt on" id="lo-es">ES</div>
            <div class="lang-opt" id="lo-zh">中文</div>
        </div>
    </div>
    <div class="back-home" onclick="window.location.href='../index.html'">
        <span id="back-home-text">← Volver al Inicio</span>
    </div>

    <!-- 货代报价表单 -->
    <div class="section">
        <h2 id="form-title">📝 Cargos en Destino (para agentes)</h2>
        <div class="card">
            <div class="fg"><label id="lbl-vb">Visto Bueno</label><input type="number" id="vb" placeholder="0.00"></div>
            <div class="fg"><label id="lbl-dc">Desconsolidación</label><input type="number" id="dc" placeholder="0.00"></div>
            <div class="fg"><label id="lbl-hd">Handling</label><input type="number" id="hd" placeholder="0.00"></div>
            <div class="fg"><label id="lbl-tdi">TDI</label><input type="number" id="tdi" placeholder="0.00"></div>
            <div class="fg"><label id="lbl-mach">MACH</label><input type="number" id="mach" placeholder="0.00"></div>
            <div class="fg"><label id="lbl-thc">THC</label><input type="number" id="thc" placeholder="0.00"></div>
            <div class="fg"><label id="lbl-transp">Transporte Interior</label><input type="number" id="transp" placeholder="0.00"></div>
            <div class="fg"><label id="lbl-alm">Almacén Temporal</label><input type="number" id="alm" placeholder="0.00"></div>
            <div class="fg"><label id="lbl-aduana">Aduana</label><input type="number" id="aduana" placeholder="0.00"></div>
            <div class="fg"><label id="lbl-bl">B/L</label><input type="number" id="bl" placeholder="0.00"></div>
            <button class="btn" onclick="submitOffer()" id="btn-submit">🔒 Enviar Oferta Bloqueada</button>
        </div>
    </div>

    <!-- 买家费用对比 -->
    <div class="section">
        <h2 id="compare-title">⚓ Costos Logísticos por Puerto</h2>
        <div id="cost-compare-container"></div>
    </div>

    <!-- AI 费用预警 -->
    <div class="section" style="margin-top: 30px;">
        <h3 id="ai-title">🤖 AI 费用预警</h3>
        <div class="card">
            <label id="ai-label">Pega aquí el texto de la cotización del agente / 粘贴货代报价文字</label>
            <textarea id="quoteText" rows="5" placeholder="Ej: Visto Bueno: 150 USD, Desconsolidación: 500 USD, ..."></textarea>
            <button class="btn" onclick="aiCheck()" id="ai-btn">🔍 Analizar con AI / AI 分析</button>
            <div id="aiResult" style="margin-top: 15px; background: #122844; padding: 12px; border-radius: 12px;"></div>
        </div>
    </div>

    <script src="c_operativo.js"></script>
</body>
</html>